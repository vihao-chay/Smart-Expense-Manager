rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'locked';
    }

    function userDoc(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isUnlockedOwner(userId) {
      return isOwner(userId)
        && (!exists(userDoc(userId)) || get(userDoc(userId)).data.status != 'locked');
    }

    function ownerSafeCreate() {
      return (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('status' in request.resource.data) || request.resource.data.status == 'active');
    }

    function ownerSafeUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && ownerSafeCreate()) || isAdmin();
      allow update: if (isUnlockedOwner(userId) && ownerSafeUpdate()) || isAdmin();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isUnlockedOwner(userId) || isAdmin();
      }
    }

    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin();
    }

    match /{path=**}/budgets/{budgetId} {
      allow read: if isAdmin();
    }

    match /{path=**}/notifications/{notificationId} {
      allow read: if isAdmin();
    }
  }
}
