rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status != 'locked';
    }

    function isOwnAvatarFile(fileName) {
      return fileName.matches('avatar_' + request.auth.uid + '_[0-9]+\\.(jpg|png|webp|gif|heic)');
    }

    function isAvatarFile(fileName) {
      return fileName.matches('avatar_[0-9]+\\.(jpg|png|webp|gif|heic)');
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isPdfUpload() {
      return request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /{userFolder}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isOwnAvatarFile(fileName)
        && isImageUpload();
      allow delete: if signedIn() && isOwnAvatarFile(fileName);
    }

    match /users/{userId}/avatars/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && isAvatarFile(fileName)
        && isImageUpload();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /avatars/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && isAvatarFile(fileName)
        && isImageUpload();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /bug_reports/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /report_exports/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && fileName.matches('smart_expense_report_[a-zA-Z0-9_-]+\\.pdf')
        && isPdfUpload();
      allow update: if false;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /documents/{documentId}/{fileName} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() && isPdfUpload();
    }
  }
}
